# AI配置
ZHIPU_API_KEY=your_zhipu_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 模型配置
AI_MODEL=glm-4
AI_TEMPERATURE=0.1

# Web配置
WEB_HOST=0.0.0.0
WEB_PORT=5000
DEBUG=True

# 知识库配置
KNOWLEDGE_DB_PATH=./knowledge/db.sqlite
VECTOR_DB_PATH=./knowledge/vectors

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/desktop-agent.log

# 执行配置
DEFAULT_TIMEOUT=30
MAX_RETRY=3
ACTION_DELAY=0.1
